# Configuració d'Entorn per a KAIROS

# Base de Dades
DB_HOST=db
DB_PORT=3306
DB_NAME=kairos_db
DB_USER=kairos_user
DB_PASSWORD=kairos_secret_password_change_this
DB_ROOT_PASSWORD=root_secret_change_this

# Servidor Web
WEB_HOST=localhost
WEB_PORT=80

# PHP
PHP_ENV=development
PHP_DEBUG=true

# Node.js / Real-time Server
NODE_ENV=development
REALTIME_PORT=3000
REALTIME_HOST=localhost

# JWT / Autenticació
JWT_SECRET=your_jwt_secret_key_change_this
JWT_EXPIRATION=86400

# Aplicació
APP_NAME=KAIROS
APP_VERSION=1.0.0
APP_DEBUG=true
